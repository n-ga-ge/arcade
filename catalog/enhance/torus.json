            "v": "max(0.01, (($tadj + ($tb + (s16(p) - 0.5 - $hw) * $tdx + (s16(p + 2) - 0.5 - $hh) * $tdy) / ($zo + (s16(p) - 0.5) * $zx + (s16(p + 2) - 0.5) * $zy)) - $lt) / 16 - 0.25)",
