{
  "engine": "torus",
  "about": "The 3D engine of Torus Games. Ashen: a level of flat faces, each with a texture and up to four light maps, drawn front to back as spans, plus models. Operation Shadow: the same rasteriser with an outdoor ground of textured, lit triangles, plus models. Needs paletteStride (emulator branch enhance-torus).",
  "viewport": {
    "width": 176,
    "height": 208
  },
  "images": [
    {
      "name": "6r21.app",
      "hash": "0x5EF10702",
      "game": "ashen",
      "hooks": [
        {
          "at": "0x17070",
          "do": "begin",
          "note": "The call that starts the 3D view of a frame: r1 the pixels, r2 and r3 the size of the view (176 by 190, above the status bar).",
          "target": {
            "pixels": "r1",
            "width": "r2",
            "height": "r3",
            "pitch": "r2 * 2",
            "format": "rgb444"
          }
        },
        {
