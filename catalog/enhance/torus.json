            "v": "($tadj + ($tb + (s16(p) - 0.5 - $hw) * $tdx + (s16(p + 2) - 0.5 - $hh) * $tdy) / ($zo + (s16(p) - 0.5) * $zx + (s16(p + 2) - 0.5) * $zy))"
