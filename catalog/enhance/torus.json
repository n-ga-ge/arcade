          "vars": {
            "tex": "u32($R + 0x17c) + 64 * (u16($face + 0x1e) & 0x3fff)",
            "kind": "u16($face + 0x1e) >> 14",
            "ent": "u32($R + 0xbbc) + 64 * u16($face + 0x3e)",
            "zo": "s32($face + 0x40)",
            "zx": "s32($face + 0x44) / 256",
            "zy": "s32($face + 0x48) / 256",
            "lm": "u32($face + 0x34)",
            "lw": "(u16($face + 0x28) >> 4) + 1",
            "lh": "(u16($face + 0x2a) >> 4) + 1",
            "ls": "s16($face + 0x20)",
            "lt": "s16($face + 0x22)"
          }
        },
        {
          "at": "0x95914",
          "do": "set",
          "vars": {
            "ox": "s32($ent + 0x18) - s32($R + 0x58)",
            "oy": "s32($ent + 0x1c) - s32($R + 0x5c)",
            "oz": "s32($ent + 0x20) - s32($R + 0x60)",
            "sx": "s32($tex + 0x08)",
            "sy": "s32($tex + 0x0c)",
            "sz": "s32($tex + 0x10)",
            "tx": "s32($tex + 0x18)",
            "ty": "s32($tex + 0x1c)",
            "tz": "s32($tex + 0x20)",
            "lit": "$kind == 0 && $lm != 0xffffffff",
            "lbase": "u32($R + 0xbcc) + $lm",
            "style0": "u8($face + 0x2c)",
            "style1": "u8($face + 0x2d)",
            "style2": "u8($face + 0x2e)",
            "style3": "u8($face + 0x2f)"
          }
        },
        {
          "at": "0x95914",
          "do": "set",
          "vars": {
            "sdx": "($sx * $m0 + $sy * $m3 + $sz * $m6) / $F",
            "sdy": "0 - ($sx * $m2 + $sy * $m5 + $sz * $m8) / $F",
            "sb": "$sx * $m1 + $sy * $m4 + $sz * $m7",
            "tdx": "($tx * $m0 + $ty * $m3 + $tz * $m6) / $F",
            "tdy": "0 - ($tx * $m2 + $ty * $m5 + $tz * $m8) / $F",
            "tb": "$tx * $m1 + $ty * $m4 + $tz * $m7",
            "sadj": "s32($tex + 0x14) / 256 - ($ox * $sx + $oy * $sy + $oz * $sz) / 65536",
            "tadj": "s32($tex + 0x24) / 256 - ($ox * $tx + $oy * $ty + $oz * $tz) / 65536",
