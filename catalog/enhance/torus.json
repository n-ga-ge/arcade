            "r": "$c0",
            "g": "$c0",
            "b": "$c0"
          },
          "texture": {
            "pixels": "$lbase",
            "width": "$lw",
            "height": "$lh",
            "format": "l8"
          },
          "blend": "none",
          "depth": "gequal"
        },
