            "R": "u32(sp + 0x2c)",
            "n": "u32(sp + 0x28)",
            "verts": "u32(sp)"
          }
        },
        {
          "at": "0x95914",
          "do": "set",
          "vars": {
            "face": "u32($R + 0x380) + 76 * r5",
            "hw": "u32($R + 0x1c) >> 1",
            "hh": "u32($R + 0x20) >> 1",
            "F": "s32($R + 0x68)",
            "m0": "s32($R + 0x70)",
            "m1": "s32($R + 0x74)",
            "m2": "s32($R + 0x78)",
            "m3": "s32($R + 0x7c)",
            "m4": "s32($R + 0x80)",
            "m5": "s32($R + 0x84)",
            "m6": "s32($R + 0x88)",
            "m7": "s32($R + 0x8c)",
            "m8": "s32($R + 0x90)"
          }
        },
        {
          "at": "0x95914",
