      "hooks": [
        {
          "at": "0x6d9a8",
          "do": "begin",
          "note": "Draws the 3D of a frame from the renderer r0: two sorted lists of triangles into its back buffer, 176 by 168 12-bit pixels; the pointer is kept at +0x2fc.",
          "target": {
            "pixels": "u32(r0 + 0x2fc)",
            "width": 176,
            "height": 168,
            "pitch": 352,
            "format": "rgb444"
          }
        },
        {
          "at": "0x3c918",
          "do": "end",
          "note": "The frame function, after the 3D and before its 2D (the message box, the status bar)."
        },
        {
          "at": "0xf56b4",
          "do": "draw",
          "note": "Type 1: an opaque textured triangle, every pixel.",
          "when": "r3 != 0 && abs(s32(r0 + 0)) <= 600 && abs(s32(r0 + 4)) <= 600 && abs(s32(r1 + 0)) <= 600 && abs(s32(r1 + 4)) <= 600 && abs(s32(r2 + 0)) <= 600 && abs(s32(r2 + 4)) <= 600 && u32(r3 + 0x24) != 0",
          "skip": true,
          "mode": "triangles",
          "count": 3,
          "vertex": "sel(i == 0, r0, sel(i == 1, r1, r2))",
          "fields": {
            "x": "s32(p)",
            "y": "s32(p + 4) + 0.5",
            "z": "0 - s32(p + 8)",
            "u": "s16(u32(sp) + 4 * i)",
            "v": "s16(u32(sp) + 4 * i + 2)"
          },
          "texture": {
            "pixels": "u32(r3 + 0x24)",
            "width": "u32(r3 + 0x1c)",
            "height": "u32(r3 + 0x20)",
            "format": "rgb444"
