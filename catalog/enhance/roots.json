{
  "engine": "roots",
  "about": "The 3D renderer of The Roots: Gates of Chaos. Textured triangles sorted far to near, drawn without a depth buffer into a 176 by 168 buffer of 12-bit pixels; nine fillers by the triangle's type.",
  "viewport": {
    "width": 176,
    "height": 208
  },
  "images": [
    {
      "name": "6r55.app",
