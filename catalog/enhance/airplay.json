{
  "engine": "airplay",
  "about": "Ideaworks3D's renderer, as System Rush links it: a display list modelled on the PlayStation's drawing commands (flat, textured and Gouraud triangles and quads, rectangles, lines), sorted far to near and turned into spans. Polygons are read after the engine has clipped them.",
  "images": [
    {
      "name": "6r63.exe",
      "hash": "0x67301A62",
      "game": "system-rush",
      "hooks": [
        {
          "at": "0x346d8",
          "do": "begin",
          "note": "Walks the frame's display list, far to near, and calls a handler per primitive.",
          "target": {
            "pixels": "u32(u32(pc - 0x1c) + 0x10)",
            "width": 176,
            "height": 208,
            "pitch": 352,
            "format": "rgb444"
          }
        },
        {
          "at": "0x346d8",
          "do": "set",
          "note": "G: the renderer's state block. T: the brightness table in use, 32 bytes of 0 to 63.",
          "vars": {
            "G": "u32(pc - 0x1c)",
            "T": "u32(pc - 0x1c) - 0x54507c + (u32(u32(pc - 0x1c) - 0x545080) << 5)"
          }
        },
        {
          "at": "0x34ef0",
          "do": "end",
          "note": "The walk has returned."
        },
        {
          "at": "0x5dc74",
          "do": "draw",
          "when": "(u32($G + 0x90) & 0x7f) == 0x0",
          "note": "A flat polygon after clipping, opaque.",
          "mode": "fan",
          "count": "r0",
          "vertex": "u32(r6 + 4 * i)",
          "fields": {
            "x": "fx(s16(p + 4), 3)",
            "y": "fx(s16(p + 6), 3)",
            "w": "s32(p + 12)",
            "r": "u8($T + (u8($G + 0x70) >> 3)) * 255 / 63",
            "g": "u8($T + (u8($G + 0x71) >> 3)) * 255 / 63",
            "b": "u8($T + (u8($G + 0x72) >> 3)) * 255 / 63"
          },
          "blend": "none"
        },
