    {
      "name": "6r51.app",
      "hash": "0xB806B021",
      "game": "shadowkey",
      "hooks": [
        {
          "at": "0x166c8",
          "do": "begin",
          "note": "Draws the 3D view, once a frame. r0: the renderer.",
          "target": {
            "pixels": "u32(r0 + 0x480)",
            "width": 176,
            "height": 208,
            "pitch": 352,
            "format": "rgb444"
          }
        },
        {
          "at": "0x166c8",
          "do": "set",
          "note": "Remembers that this frame has a 3D view.",
          "vars": {
            "view": 1
          }
        },
        {
          "at": "0x4fdb0",
          "do": "draw",
          "note": "Inside the screen fade, before its loop over the picture; r5: how much it takes from every colour channel, 0 to 15. Captured as one dark rectangle over the view.",
          "when": "r5 > 0",
          "mode": "fan",
          "count": 4,
          "vertex": "i",
          "fields": {
            "x": "sel(p == 1 || p == 2, 176, 0)",
            "y": "sel(p >= 2, 208, 0)",
            "r": "255 - 17 * r5",
            "g": "255 - 17 * r5",
            "b": "255 - 17 * r5"
          },
          "blend": "multiply",
          "depth": "none"
        },
        {
          "at": "0x69b20",
          "do": "end",
          "when": "$view",
          "note": "After the 3D view, its resolve into the 16-bit picture and the screen fade; the game's 2D comes after this."
        },
        {
          "at": "0x69b20",
          "do": "set",
          "note": "The next frame has a 3D view only if the view function runs again.",
          "vars": {
            "view": 0
          }
        },
