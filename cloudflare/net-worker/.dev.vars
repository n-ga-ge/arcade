# Local settings for `npx wrangler dev`, which reads this file by itself.
# It holds no secret and is committed on purpose, so that a local relay works
# without setup: pages served from this machine may open rooms, on any port,
# and so may a command-line client that sends no Origin header ("none").
# None of this reaches a deployment: there ALLOWED_ORIGINS comes from
# wrangler.jsonc, where it is empty.
ALLOWED_ORIGINS="http://127.0.0.1:* http://localhost:* none"
