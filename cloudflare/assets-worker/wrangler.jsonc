// The assets Worker: serves n-ga.ge/assets/* from the private R2 bucket.
// README.md explains every setting; `npx wrangler deploy` publishes it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "n-ga-ge-assets",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // The site's hostname, here and nowhere else. The Pages site owns the rest
  // of the hostname, so the route covers /assets/ only. The Worker takes the
  // site's origin from the request it receives.
  "routes": [{ "pattern": "n-ga.ge/assets/*", "zone_name": "n-ga.ge" }],

  // Also at https://n-ga-ge-assets.<account subdomain>.workers.dev, which is
  // what preview deployments of the site and CI can use.
  "workers_dev": true,
  "preview_urls": false,

  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "n-ga-ge-assets" }],

  "vars": {
    // Origins besides the site itself that may load the assets, separated by
    // spaces or commas. "*." stands for any subdomain, for example
    // "https://*.n-ga-ge.pages.dev" for the preview deployments of a Pages
    // project. Empty: only the site. List a hostname only once it is known to
    // belong to this account.
    "ALLOWED_ORIGINS": ""
  },

  // The secret ASSETS_TOKEN is not in this file: `npx wrangler secret put ASSETS_TOKEN`.

  "observability": { "enabled": true }
}
